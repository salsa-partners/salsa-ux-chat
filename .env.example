# ============ Obligatorias ============
ANTHROPIC_API_KEY=            # console.anthropic.com → API keys (sk-ant-api03-...)
SESSION_SECRET=               # texto largo aleatorio para firmar la cookie de sesión (ej. 64 caracteres)
ACCESS_CODE=                  # código que compartes con el equipo
ADMIN_CODE=                   # código SOLO para ti, para entrar a /admin

# ============ Memoria y datos (recomendado para producción) ============
DATABASE_URL=                 # la crea Vercel al conectar Neon (Storage → Neon Postgres)
BLOB_STORE_ID=                # la crea Vercel al conectar Blob (la app usa OIDC; también sirve BLOB_READ_WRITE_TOKEN)

# ============ Navegador para revisiones en vivo ============
BROWSERBASE_API_KEY=          # browserbase.com → Settings
BROWSERBASE_CONTEXT_ID=       # se genera en /admin y se pega aquí

# ============ Topes de gasto (lib/usage.js) ============
# BUDGET_MONTHLY_USD=20            # modelo + búsquedas web, todo el mes
# BUDGET_DAILY_USD_PER_USER=3      # por persona por día
# BUDGET_RUN_USD=1.5               # una sola respuesta
# BROWSER_MINUTES_MONTHLY=60       # minutos de navegador (Browserbase Free es limitado)
# BROWSERBASE_KEEP_ALIVE=off       # on solo en planes pagos de Browserbase
# BROWSERBASE_MAX_SESSION_SEC=300  # Free: 300

# ============ Ajustes opcionales ============
# ANTHROPIC_MODEL=claude-sonnet-5-5   # modelo del agente
# JUDGE_MODEL=claude-opus-5-5         # modelo que califica las evals
# AGENT_EFFORT=medium                 # low | medium | high (más alto = más profundo y más caro)
# WEB_TOOLS=on                        # off apaga web_search / web_fetch
# REFUSAL_FALLBACK=on                 # off apaga el respaldo automático ante rechazos del modelo
# DEFAULT_PROJECT=longevidad-2026
# ALLOWED_EMAIL_DOMAINS=salsagrowth.la # solo correos de estos dominios (separados por coma)
# CHATS_PER_10_MIN=20                 # mensajes por persona cada 10 minutos
# AGENT_RUNS_PER_HOUR=6               # revisiones en vivo por persona por hora
